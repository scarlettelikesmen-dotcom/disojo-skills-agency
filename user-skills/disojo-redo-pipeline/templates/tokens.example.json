{
  "name": "A - Studio split",
  "family": "F9",
  "fonts": {
    "sans": { "family": "Inter Tight", "source": "google", "weights": [500, 700], "licence": "OFL" },
    "display": { "family": "Inter Tight", "source": "google", "weights": [700], "licence": "OFL" },
    "mono": { "family": "JetBrains Mono", "source": "google", "weights": [500], "licence": "OFL" }
  },
  "scale": {
    "label":   { "min": 12, "max": 13, "font": "mono", "weight": 500, "tracking": -0.01, "leading": 1.25, "upper": true },
    "small":   { "min": 14, "max": 15, "font": "sans", "weight": 500, "tracking": -0.01, "leading": 1.3 },
    "body":    { "min": 16, "max": 18, "font": "sans", "weight": 500, "tracking": -0.01, "leading": 1.3 },
    "lead":    { "min": 19, "max": 24, "font": "sans", "weight": 500, "tracking": -0.015, "leading": 1.2 },
    "h3":      { "min": 22, "max": 32, "font": "display", "weight": 700, "tracking": -0.02, "leading": 1.1 },
    "h2":      { "min": 34, "max": 64, "font": "display", "weight": 700, "tracking": -0.03, "leading": 1.0 },
    "display": { "min": 44, "max": 128, "font": "display", "weight": 700, "tracking": -0.04, "leading": 0.92 },
    "mega":    { "min": 64, "max": 260, "font": "display", "weight": 700, "tracking": -0.05, "leading": 0.85 }
  },
  "colors": {
    "ink":    { "hex": "#0B0B0A", "job": "text and dark sections" },
    "paper":  { "hex": "#E9E8E3", "job": "page background" },
    "accent": { "hex": "#FF4A1C", "job": "one hero word, stats, the CTA surface" },
    "grey":   { "hex": "#8E8A84", "job": "secondary text" },
    "spare":  null
  },
  "radius": "sharp",
  "grain": true,
  "motion": { "easeInOut": "cubic-bezier(0.83,0,0.17,1)", "easeOut": "cubic-bezier(0.16,1,0.3,1)", "fast": 0.3, "base": 0.5, "slow": 0.75 },
  "label_grammar": "(01) Label",
  "viewport": { "min": 390, "max": 1512 }
}

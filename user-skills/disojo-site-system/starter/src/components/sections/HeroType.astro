---
// Job: type at viewport scale, only when the words are the real thing.
// lines[] = forced line breaks. No sentence or button by default; add them only if the picked idea demands it.
import Pic from '../Pic.astro';
// mega: only for 1-3 short words a line; anything longer uses display so the whole hero fits the first screen.
interface Props { lines: string[]; label?: string; img?: any; mega?: boolean }
const { lines, label, img, mega = false } = Astro.props;
---
<section class="s-ht wrap">
  {label && <p class="t-label s-ht-l">{label}</p>}
  <h1 class:list={[mega ? 't-mega' : 't-display', 's-ht-h']}>{lines.map((l) => <span class="ln"><span>{l}</span></span>)}</h1>
  {img && <div class="s-ht-b"><Pic {...img} eager sizes="(max-width:860px) 100vw, 30vw" class="s-ht-p" /></div>}
</section>

---
// Job: open on the client's real world. A photo across the whole first screen and the words the idea calls for, nothing else.
// Needs a tier-A photo 2400px+ wide (see disojo-image-pipeline). Never stock under a client name.
// No sentence, button or card by default: a headline + sentence + button on a photo fails the gate.
import Pic from '../Pic.astro';
interface Props { img: any; lines: string[] }
const { img, lines } = Astro.props;
---
<section class="s-hp on-ink">
  <Pic {...img} eager sizes="(orientation: portrait) 180vh, 100vw" class="s-hp-bg" />
  <div class="s-hp-in wrap">
    <h1 class="t-display s-hp-h">{lines.map((l) => <span class="ln"><span>{l}</span></span>)}</h1>
  </div>
</section>

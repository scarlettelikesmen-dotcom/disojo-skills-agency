---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/kernel.css';
import Btn from '../components/Btn.astro';
import FootPlace from '../components/FootPlace.astro';
import { BRAND, yr } from '../data/brand.js';
// Motion: the Disojo kernel (src/kernel, synced from $SK/kernel by scripts/sync_kernel.sh). Barba keeps the
// header, menu and veil outside the swapped container; the footer is inside it so data-close works per page.
// ns = Barba namespace (one per page type). cursor: opt in only when the idea needs a cursor (see research kit-code.md).
interface Props { title: string; desc?: string; route?: string; og?: string; dark?: boolean; ns?: string; cursor?: boolean }
const { title, desc = '', route = '/', og = '', dark = false, ns = route === '/' ? 'home' : 'page', cursor = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {BRAND.noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={BRAND.origin + route} />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} />
  {og && <meta property="og:image" content={og} />}
  <link rel="icon" href="/favicon.png" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {BRAND.fonts && <><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href={BRAND.fonts} rel="stylesheet" /></>}
</head>
<body class:list={{ dark, grain: BRAND.grain }} data-barba="wrapper">
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav" id="nav" data-k-header>
    <a class="mark t-small" href="/" aria-label={`${BRAND.name}, home`}><slot name="logo">{BRAND.name}</slot></a>
    <nav class="links t-small" aria-label="Main">{BRAND.nav.map(([h, t]) => <a href={h} data-roll aria-current={route === h ? 'page' : undefined}>{t}</a>)}</nav>
    <div class="nav-r">
      {BRAND.cta && <Btn href={BRAND.cta[0]} label={BRAND.cta[1]} size="sm" />}
      <button class="menu-b t-label" type="button" data-k-menu-toggle data-roll aria-controls="pm">Menu</button>
    </div>
  </header>
  <div class="pm" id="pm" data-k-menu>
    <nav aria-label="Menu">{BRAND.nav.map(([h, t]) => <span class="k-mask"><a class="t-h2" href={h} data-k-menu-item data-roll>{t}</a></span>)}</nav>
    <div class="pm-foot t-small">{BRAND.tel && <a href={`tel:${BRAND.tel.replace(/^tel:/, '')}`}>{BRAND.tel.replace(/^tel:/, '')}</a>}{BRAND.mail && <a href={BRAND.mail}>{BRAND.mail.replace('mailto:', '')}</a>}</div>
  </div>
  <div class="veil" data-k-veil></div>
  {cursor && <div data-k-cursor><span class="k-dot"><span data-k-cursor-label></span></span></div>}
  <div data-barba="container" data-barba-namespace={ns}>
  <main id="main"><slot /></main>
  <footer class="foot">
    <slot name="footer" />
    <div class="foot-base t-label">
      <span>© {yr} {BRAND.name}</span>
      <FootPlace />
      <a class="credit" href="https://disojostudio.com" target="_blank" rel="noopener">Design &amp; Systems · © Disojo Studio 2026</a>
    </div>
  </footer>
  </div>
  <script>import '../kernel/index.js';</script>
</body>
</html>

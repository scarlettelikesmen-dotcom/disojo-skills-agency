---
import Base from '../layouts/Base.astro';
---
<Base title="Kernel lab · Second page" ns="second">
  <section class="hero" style="min-height:80svh">
    <h1 class="disp" data-reveal="chars" data-reveal-now>Second page</h1>
    <p class="lede" data-reveal="lines" data-reveal-delay="0.3">You arrived through the veil. The old page hid what you could see, cleaned up after itself, and this one played its own intro.</p>
  </section>
  <section class="sec">
    <div class="rule" data-reveal="rule"></div>
    <h2 class="h2" data-reveal="words">Back the way you came</h2>
    <a class="cta" href="/" data-magnetic="0.35" data-roll><span data-magnetic-inner data-roll-label>Return to index</span></a>
  </section>
</Base>

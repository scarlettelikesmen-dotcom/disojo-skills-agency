---
import Base from '../layouts/Base.astro';
const rows = [
  ['Reveal vocabulary', 'lines, words, chars, turn, focus, block, rule, media', '/ph1.svg'],
  ['Module registry', 'one init per attribute, cleaned on leave', '/ph2.svg'],
  ['Pointer layer', 'roll, magnetic, cursor, follower', '/ph3.svg'],
  ['Accent last', 'WebGL loads after the intro', '/ph4.svg'],
];
---
<Base title="Kernel lab · Index" ns="index">
  <section class="hero" data-ground="light">
    <canvas data-k-field aria-hidden="true"></canvas>
    <h1 class="disp" data-reveal="turn" data-reveal-now>Motion kernel</h1>
    <p class="lede" data-reveal="lines" data-reveal-delay="0.3">The base every Disojo site starts from. The look is a placeholder; the motion is the test.</p>
  </section>

  <section class="sec" id="ink" data-ground="light">
    <p class="cap" data-reveal="block">01 · data-ink</p>
    <p class="ink" data-ink>A statement that inks in letter by letter, so the reader's pace and the scroll are the same thing.</p>
  </section>

  <section class="sec" id="ground" data-ground="dark">
    <p class="cap" data-reveal="block">02 · data-ground, data-parallax, focus</p>
    <p class="focus" data-reveal="focus">The header turned light exactly when this dark section reached it.</p>
    <div class="frame" data-parallax="0.12"><img data-parallax-media src="/ph2.svg" alt="Placeholder image" /></div>
    <h2 class="turnh" data-reveal="turn">Scroll back up</h2>
    <p class="body" data-reveal="lines">Headings and paragraphs reset once they leave below the screen, so they play again on the way down.</p>
  </section>

  <section class="sec" id="list" data-ground="light" data-follow-list>
    <p class="cap" data-reveal="block">03 · Four parts</p>
    <ul class="list" data-reveal-group>
      {rows.map(([t, s, img]) => (
        <li data-reveal="block"><a href="/second/" data-follow-src={img} data-roll-host><span data-roll><span data-roll-label>{t}</span></span><span>{s}</span></a></li>
      ))}
    </ul>
    <div class="follow" data-follow-card><img src="/ph1.svg" alt="" /></div>
  </section>

  <section class="sec" data-ground="light">
    <div class="media" data-reveal="media"><img src="/ph2.svg" alt="Placeholder image" /></div>
    <a class="cta" href="/second/" data-magnetic="0.35" data-roll><span data-magnetic-inner data-roll-label>Go to the second page</span></a>
  </section>
</Base>

---
// Kernel lab layout: wrapper, persistent UI (cursor, veil, menu, nav) outside the container.
import '../styles/kernel.css';
import '../styles/lab.css';
interface Props { title: string; ns: string; desc?: string }
const { title, ns, desc = 'Disojo motion kernel lab' } = Astro.props;
const links = [['/', 'Index'], ['/second/', 'Second page']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={desc} /><meta name="robots" content="noindex" />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body data-barba="wrapper">
  <header class="nav">
    <a href="/" class="mark" data-roll>Kernel lab</a>
    <nav class="nav-l">{links.map(([h, t]) => <a href={h} data-roll data-cursor>{t}</a>)}</nav>
    <button class="menu-b" type="button" data-k-menu-toggle data-roll>Menu</button>
  </header>
  <div data-k-menu class="menu">
    <ul>{links.map(([h, t]) => <li class="k-mask"><a href={h} data-k-menu-item data-roll>{t}</a></li>)}</ul>
  </div>
  <div data-k-veil class="veil"></div>
  <div data-k-cursor><span class="k-dot"><span data-k-cursor-label></span></span></div>

  <main data-barba="container" data-barba-namespace={ns}>
    <slot />
    <footer class="foot">
      <p>Mumbai · <time data-clock="Asia/Kolkata">--:--</time></p>
      <a href="https://disojostudio.com" data-roll data-no-swap>Design &amp; Systems · © Disojo Studio 2026</a>
    </footer>
  </main>
  <script>import '../kernel/index.js';</script>
</body>
</html>

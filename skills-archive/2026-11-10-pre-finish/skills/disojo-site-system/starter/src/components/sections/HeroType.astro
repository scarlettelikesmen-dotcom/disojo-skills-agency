---
// Job: say what the business is in one line at viewport scale. Use when the strongest asset is the sentence, or no photo can carry a full screen.
// One headline (lines[] = forced line breaks), one sentence, ONE button. Optional small photo as proof, not decoration.
import Btn from '../Btn.astro'; import Pic from '../Pic.astro';
// mega: only for 1-3 short words a line; anything longer uses display so the whole hero fits the first screen.
interface Props { lines: string[]; sub: string; cta: [string, string]; label?: string; img?: any; mega?: boolean }
const { lines, sub, cta, label, img, mega = false } = Astro.props;
---
<section class="s-ht wrap">
  {label && <p class="t-label s-ht-l">{label}</p>}
  <h1 class:list={[mega ? 't-mega' : 't-display', 's-ht-h']}>{lines.map((l) => <span class="ln"><span>{l}</span></span>)}</h1>
  <div class="s-ht-b">
    <div class="s-ht-c"><p class="t-lead">{sub}</p><Btn href={cta[0]} label={cta[1]} /></div>
    {img && <Pic {...img} eager sizes="(max-width:860px) 100vw, 30vw" class="s-ht-p" />}
  </div>
</section>
